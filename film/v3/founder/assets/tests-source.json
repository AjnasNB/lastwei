        "test(\"execution replay fails\", async () => {",
        "  const f = await fixture();",
        "  await fund(f);",
        "  await write(wallets[2], f.account, \"LastWeiAccount\", \"execute\", [",
        "    f.id,",
        "    f.data,",
        "  ]);",
        "  await rejected(f, \"execute\", [f.id, f.data], wallets[2], 0n, \"NotFunded\");",
        "});"
      ],
      "startLine": 307,
      "name": "execution replay fails"
    },
