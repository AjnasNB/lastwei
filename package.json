{
  "name": "lastwei",
  "version": "1.0.0",
  "description": "Intent-locked shortfall sponsorship for Ethereum payments",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "compile": "node scripts/compile.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/contracts.test.mjs tests/relay.test.mjs",
    "build": "vite build",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test:ui": "playwright test",
    "deploy:contracts": "node scripts/deploy.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@openzeppelin/contracts": "5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@azure/static-web-apps-cli": "^2.0.10",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ganache": "^7.9.2",
    "prettier": "^3.9.10",
    "solc": "^0.8.37",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
